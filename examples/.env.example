# Copy this file to .env and fill in the values.
#
# One file covers both example stacks:
#   - docker-compose.yml         (full standalone stack: Directus + DB + sidecar)
#   - docker-compose.backup.yml  (sidecar added to an existing Directus stack)
# Variables only used by one of them are marked below; variables the stack you
# run does not reference are simply ignored.

# --- Shared ---
# Shared secret for sidecar <-> Directus authentication
BACKUP_SECRET=change-me-generate-a-random-string
# Admin email for failure notifications
ADMIN_EMAIL=admin@example.com
# Database credentials
DB_USER=directus
DB_PASSWORD=change-me
DB_DATABASE=directus

# --- Full standalone stack only (docker-compose.yml) ---
# Directus app secret (random string)
DIRECTUS_SECRET=change-me-generate-a-random-string
# Initial Directus admin password
ADMIN_PASSWORD=change-me

# --- Sidecar add-on only (docker-compose.backup.yml) ---
# Optional. Static Directus token for failure notifications + version detection.
# The token's user does NOT need admin — just read users/roles + create
# notifications. See docs/configuration.md. Leave empty to disable both.
BACKUP_TOKEN=

# --- Optional (sidecar defaults shown) ---
# Operator kill-switches, secure-by-default OFF. Set to "true" (or "1") to
# allow importing foreign backup archives / downloading backups. Both are
# disabled unless explicitly enabled here. See docs/configuration.md.
# BACKUP_IMPORT_ENABLED=false
# BACKUP_EXPORT_ENABLED=false
# Database adapter
# DB_ADAPTER=postgres
# Dump format — "custom" (compressed, default) or "plain" (SQL)
# BACKUP_DUMP_FORMAT=custom
# Max minutes a backup/restore may run before the runner is killed (0 = no limit)
# RUNNER_TIMEOUT_MIN=90
# Redis cache to flush after restore; only this DB index is flushed (FLUSHDB)
# CACHE_HOST=cache
# CACHE_PORT=6379
# CACHE_DB=0
