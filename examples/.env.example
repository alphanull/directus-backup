# Copy this file to .env and fill in the values.
#
# Used by docker-compose.yml (the full standalone stack). The standalone
# extension reuses Directus's own database and cache settings and authenticates
# via Directus accountability.

# --- Required ---
# Directus app secret (random string)
DIRECTUS_SECRET=change-me-generate-a-random-string
# Initial Directus admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Database password
DB_PASSWORD=change-me

# --- Database (defaults shown) ---
# DB_USER=directus
# DB_DATABASE=directus

# --- Optional (defaults shown) ---
# Operator kill-switches, secure-by-default OFF. Set to "true" (or "1") to allow
# importing foreign backup archives / downloading backups. See docs/security.md.
# BACKUP_IMPORT_ENABLED=true
# BACKUP_EXPORT_ENABLED=true
# Max minutes a backup/restore may run before the runner is killed (0 = no limit)
# RUNNER_TIMEOUT_MIN=90
# Redis cache to flush after restore; set CACHE_HOST= (empty) to disable
# CACHE_HOST=cache
# CACHE_PORT=6379
# CACHE_DB=0
# Optional webhook fired after a successful restore
# HOOK_POST_RESTORE_URL=
# HOOK_POST_RESTORE_SECRET=
# HOOK_POST_RESTORE_HINT=
