{
	"compilerOptions": {
		"rootDir": ".",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["./src/**/*.ts", "./test/**/*.ts", "vitest.config.ts"]
}
